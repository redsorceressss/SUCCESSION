{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JewelleryInvoiceAnnotation",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["invoice_id", "image_file", "fields"],
    "properties": {
      "invoice_id": { "type": "string" },
      "image_file": { "type": "string" },
      "verified_by": { "type": "string" },
      "collection_date": { "type": "string", "format": "date" },
      "fields": {
        "type": "object",
        "required": ["item_name", "weight_grams", "karat", "total_amount"],
        "properties": {
          "item_name": { "type": "string" },
          "weight_grams": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$" },
          "karat": { "type": "integer", "enum": [14, 18, 20, 22, 23, 24] },
          "making_charge": { "type": "string" },
          "gst_percent": { "type": "string" },
          "total_amount": { "type": "string" },
          "karigar_name": { "type": ["string", "null"] }
        }
      }
    }
  }
}
