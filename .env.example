# Environment configuration template for SUCCESSION
# Copy this file to .env: copy .env.example .env

# Set to "production" for deployment — enforces secret key requirements
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# CORS: comma-separated list of allowed origins (REQUIRED in production)
# Example: ALLOWED_ORIGINS=https://app.succession.com,https://admin.succession.com
ALLOWED_ORIGINS=

# Rate limiting: requests per period (e.g., 60/minute, 100/hour)
RATE_LIMIT=60/minute

# Database URL: SQLite default for local development, PostgreSQL for deployment
DATABASE_URL=sqlite:///./swarn.db

# JWT Access Token expiration in minutes
ACCESS_TOKEN_MINUTES=60

# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Accounting tolerances
TOLERANCE_G=0.20
SCALE_MATCH_G=0.01

# Optional LLM integration (OpenAI-compatible)
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional server-side speech-to-text
WHISPER_ENABLED=false
WHISPER_MODEL=small

# Advisory Agent settings (provide securely via local .env when needed; do not commit real credentials)
AGENT_LOGIN=
AGENT_PASSWORD=
API_BASE_URL=http://127.0.0.1:8000
